# plaid-agent MCP tools. Copy to .env for local development.
# With everything blank, tools run on mock Fidelity/Robinhood data and write
# snapshots under ./data/store — no Plaid or AWS account needed.

# --- Plaid -----------------------------------------------------------------
# Blank = mock mode.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox            # sandbox | production
PLAID_PRODUCTS=investments
PLAID_COUNTRY_CODES=US

# --- Tokens ----------------------------------------------------------------
# file (local dev) | secrets-manager (default inside Lambda)
TOKEN_STORE=file
TOKEN_STORE_PATH=./data/items.json
TOKEN_ENCRYPTION_KEY=        # 32+ chars; required once anything is linked locally
# Secrets Manager: one secret per linked Item, named <prefix><itemId>
PLAID_TOKEN_SECRET_PREFIX=plaid-agent/items/

# --- Snapshots -------------------------------------------------------------
# local (local dev) | s3 (default inside Lambda)
SNAPSHOT_STORE=local
SNAPSHOT_DIR=./data/store
SNAPSHOT_BUCKET=             # required when SNAPSHOT_STORE=s3
STALE_AFTER_HOURS=12

# --- Local HTTP server (npm run dev) ----------------------------------------
PORT=3000
HOST=127.0.0.1               # non-loopback requires MCP_API_KEY
MCP_API_KEY=

LOG_LEVEL=info
